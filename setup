#!/bin/bash

# Description:
# This script will detect the system's OS, then apply the dotfile configs for that system type.

# Grabbing the OS type from the /etc/os-release file,
# scoping the shellcheck directive to only this function.
#
# If /etc/os-release does not exist, assumes macos

get_os_type() {
  # This is only applicable on Linux machines.
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release

    local os_type="${ID_LIKE}"

    if [[ -z "${os_type}" ]]; then
      os_type="${ID}"
    fi

    echo "${os_type}"
  else
    echo "macos"
  fi
}

clean_previous_links() {
  local target_path="${1}"

  if [[ -e "${target_path}" ]]; then
    find "${target_path}" -type l -delete
  fi
}

create_symlink() {
  local origin_path="$1"
  local target_path="$2"

  if [[ ! -e "${origin_path}" ]]; then
    echo "create_symlink: Invalid origin path: ${origin_path}" >&2
  else

    clean_previous_links "${target_path}"

    if [[ -e "${target_path}" && ! -L "${target_path}" ]]; then
      mv "${target_path}" "${target_path}.bak"
    fi

    ln -sf "${origin_path}" "${target_path}"
  fi
}

# Takes in origin directory and a target directory.
# Iterates through all files within origin directory and creates symLinks
# within the target directory.
symlink_dir_files() {
  local origin_dir="${1}"
  local target_dir="${2}"

  if [[ -d "${origin_dir}" ]]; then
    echo "Creating symLinks for ${origin_dir##*/} files.."

    # Making sure targetDir exists
    [[ ! -d "${target_dir}" ]] && mkdir -p "${target_dir}"

    for file in "${origin_dir}"/*; do
      local file_name="${file##*/}"
      create_symlink "${file}" "${target_dir}/${file_name}"
    done

    echo "Done." && echo ""
  else
    echo "symlink_dir_files: ERROR: Invalid originDir: ${origin_dir}" >&2
  fi
}

symlink_scripts() {
  local script_dir="${1}"
  echo "Creating symLinks for scripts.."

  for script in "${script_dir}"/scripts/*; do
    local script_name="${script##*/}"
    create_symlink "${script}" "${HOME}/scripts/${script_name}"
    chmod +x "${script}"
  done

  echo "NOTE: Don't forget to add \`export PATH=\"\${HOME}/scripts:\${PATH}\"\` to your ~/.bashrc"
  echo "Done." && echo ""
}

main() {
  local os_type
  os_type="$(get_os_type)"

  # Grabbing the script's directory
  local script_path
  script_path="$(realpath "${BASH_SOURCE[0]}")"
  local script_dir
  script_dir="$(dirname "${script_path}")"

  # Shorthand function for checking if software is installed
  chmod +x "${script_dir}/scripts/is-installed"
  local is_installed
  is_installed="${script_dir}/scripts/is-installed"

  # i3 Configs
  if "${is_installed}" i3; then
    echo "Creating symLinks for i3.."
    create_symlink "${script_dir}/i3-wm" "${HOME}/.config/i3"
    echo "Done." && echo ""
  fi

  # rofi Configs
  if "${is_installed}" rofi; then
    echo "Creating symLinks for rofi.."
    create_symlink "${script_dir}/rofi" "${HOME}/.config/rofi"
    create_symlink "${script_dir}/.local/share/rofi/themes" "${HOME}/.local/share/rofi/themes"
    echo "Done." && echo ""
  fi

  # picom Configs
  if "${is_installed}" picom; then
    echo "Creating symLinks for picom.."
    create_symlink "${script_dir}/picom/picom.conf" "${HOME}/.config/picom.conf"
    echo "Done." && echo ""
  fi

  # Starship Configs
  if "${is_installed}" starship; then
    echo "Creating symLinks for starship.."
    create_symlink "${script_dir}/starship/starship.toml" "${HOME}/.config/starship.toml"
    echo "NOTE: Starship requires adding \`eval \"\$(starship init bash)\"\` to your ~/.bashrc file"
    echo "Done." && echo ""
  fi

  # Tmux Configs
  if "${is_installed}" tmux; then
    echo "Creating symLinks for tmux.."
    create_symlink "${script_dir}/tmux/tmux.conf" "${HOME}/.tmux.conf"
    echo "Done." && echo ""
  fi

  # Alacritty Configs
  if "${is_installed}" alacritty; then
    echo "Creating symLinks for alacritty.."
    [[ ! -d ~/.config/alacritty ]] && mkdir -p "${HOME}/.config/alacritty"
    create_symlink "${script_dir}/alacritty/alacritty.toml" "${HOME}/.config/alacritty/alacritty.toml"
    echo "Done." && echo ""
  fi

  # EDITOR to vim
  if [[ "${EDITOR}" != "vim" ]]; then
    echo "Checking for EDITOR set to 'vim'.."
    echo "NOTE: Your current EDITOR is not set to vim."
    echo "Consider adding \`export EDITOR=vim\` to your ~/.bashrc"
    echo "Done." && echo ""
  fi

  # Vimrc Configs
  if "${is_installed}" vim; then
    echo "Creating symLinks for vimrc.."
    create_symlink "${script_dir}/vimrc/${os_type}-vimrc" "${HOME}/.vimrc"
    echo "Done." && echo ""
  fi

  # AstroNvim Configs
  if "${is_installed}" nvim; then
    echo "Creating symLinks for AstroNvim.."
    create_symlink "${script_dir}/astronvim" "${HOME}/.config/nvim"
    echo "Done." && echo ""
  fi

  # Claude-Code Configs
  if "${is_installed}" claude; then
    echo "Creating symLinks for Claude-Code.."
    [[ -d "${HOME}/.claude" ]] && create_symlink "${script_dir}/claude/CLAUDE.md" "${HOME}/.claude/CLAUDE.md"
    echo "Done." && echo ""
  fi

  # Add personal scripts symlink
  [[ ! -d "${HOME}/scripts" ]] && mkdir "${HOME}/scripts"
  symlink_scripts "${script_dir}"
}

main "$@"
